{
  "name": "aveela-event-space",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler d1 migrations apply aveela --remote && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply aveela --remote",
    "db:migrate:local": "wrangler d1 migrations apply aveela --local",
    "preview": "node --no-warnings test/serve.mjs",
    "test": "node --no-warnings test/smoke.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22.5"
  }
}
